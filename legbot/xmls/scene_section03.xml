<?xml version="1.0" ?>
<!-- Section03 终点楼梯导航场景：挂载 0126 版本第三段地形。 -->
<mujoco model="legbot navigation - section03">
  <!-- 编译器设置：角度单位为弧度，网格目录指向 meshes。 -->
  <compiler angle="radian" meshdir="meshes/" autolimits="true"/>
  
  <!-- 引入legbot机器人 -->
  <include file="legbot.xml" />
  
  <!-- 场景统计与相机范围参数。 -->
  <statistic center="0 26 0.1" extent="15" meansize="0.04" />

  <!-- 可视化渲染参数。 -->
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="120" elevation="-20" />
    <map force="0.01" />
    <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2" />
    <quality shadowsize="8192" />
  </visual>

  <!-- 资源定义：网格、纹理、材质与高度场。 -->
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    
    <!-- 加载section03地形模型 - 使用0126版本 -->
    <model name="section03C" file="0126_C_section03.xml"/>
  </asset>

  <!-- 世界坐标系实体：灯光、地面、机器人与地形。 -->
  <worldbody>
    <light pos="0 26 10" dir="0 0 -1" directional="true" />
    
    <!-- 加载section03地形 -->
    <attach model="section03C" prefix="0"/>
    
    <!-- 地面用于足部接触检测 -->
    <geom name="ground" pos="0 26 -10" size="100 100 0.01" type="plane" rgba="0 0 0 0" contype="1" conaffinity="1"/>
  </worldbody>

  <!-- 传感器：关节状态、IMU 与接触检测。 -->
  <sensor>
    <contact name="FR_foot_contact" geom2="FR" geom1="ground" data="normal" num="1" />
    <contact name="FL_foot_contact" geom2="FL" geom1="ground" data="normal" num="1" />
    <contact name="RR_foot_contact" geom2="RR" geom1="ground" data="normal" num="1" />
    <contact name="RL_foot_contact" geom2="RL" geom1="ground" data="normal" num="1" />
  </sensor>

</mujoco>
