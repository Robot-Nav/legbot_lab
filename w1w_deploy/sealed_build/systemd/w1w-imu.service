[Unit]
Description=W1W CPU-bound DM IMU service
After=network.target

[Service]
Type=simple
User=kickpi
Group=kickpi
SupplementaryGroups=dialout
ExecStart=@PREFIX@/bin/imu_service --device /dev/ttyACM0 --baud 921600 --bind-host 127.0.0.1 --port 55200 --cycle-us 1000 --timeout-ms 100
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
