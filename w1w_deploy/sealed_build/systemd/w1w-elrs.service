[Unit]
Description=W1W CPU-bound ELRS CRSF receiver service
After=network.target

[Service]
Type=simple
User=kickpi
Group=kickpi
SupplementaryGroups=dialout
ExecStart=@PREFIX@/bin/elrs_service --device /dev/ttyS6 --baud 420000 --port 55201 --cycle-us 1000 --timeout-ms 100 --stats
Restart=on-failure
RestartSec=1
KillSignal=SIGTERM
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
