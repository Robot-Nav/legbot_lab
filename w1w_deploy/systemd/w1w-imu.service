[Unit]
Description=W1W DM IMU UDP service
After=network.target

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/default/w1w
ExecStart=@PREFIX@/current/bin/imu_service --device ${W1W_IMU_DEVICE} --baud ${W1W_IMU_BAUD} --bind-host 127.0.0.1 --port 55200 --cycle-us 1000 --timeout-ms 100
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
